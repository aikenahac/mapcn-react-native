{
  "name": "mapcn-rn",
  "version": "2.0.1",
  "description": "CLI for installing and managing mapcn-rn map components -- init, add, list, diff, doctor, provider, and migrate.",
  "keywords": [
    "mapcn",
    "react-native",
    "expo",
    "maps",
    "maplibre",
    "mapbox",
    "maptiler",
    "cli",
    "shadcn",
    "registry"
  ],
  "homepage": "https://mapcn-rn.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aikenahac/mapcn-react-native.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/aikenahac/mapcn-react-native/issues",
  "author": "Aiken Tine Ahac",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "mapcn-rn": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "node --import tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "execa": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
